APP_NAME="API Establo Polo Norte"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=America/Guayaquil

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Seguridad (JWT HS256) ---
# Genera el secreto con: php artisan jwt:secret   (NUNCA lo subas al repositorio)
JWT_SECRET=
JWT_TTL_MINUTOS=120

# --- Servicio SOAP MeteoPoloNorteService ---
# Mock local: php -S 127.0.0.1:8089 mock-soap/server.php   (o la URL del mock del docente)
METEO_SOAP_URL=http://127.0.0.1:8089/meteo
METEO_SOAP_TIMEOUT=3
METEO_SOAP_INTENTOS=2
METEO_SOAP_BACKOFF_MS=300

# --- Usuarios de prueba que crea el seeder (solo para desarrollo) ---
DEMO_JEFE_CLAVE=Establo2026!
DEMO_ELFO_CLAVE=Elfo2026!
